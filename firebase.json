{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "**/*.md"
    ],
    "headers": [
      { "source": "**/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "**/manifest.json", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "**/*.@(html|js|css|json)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
    ]
  }
}
