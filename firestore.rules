rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Quién es quién ─────────────────────────────────────────────
    // Cada persona del equipo tiene un documento users/{correo en minúsculas} con su nivel y la inmobiliaria (negocio) a la que pertenece.
    // Todos los datos de una inmobiliaria viven bajo negocios/{id}/… y SOLO los ve el equipo de esa inmobiliaria.
    function mail() { return request.auth.token.email.lower(); }
    function logueado() { return request.auth != null && request.auth.token.email != null; }
    function perfilDe() { return get(/databases/$(database)/documents/users/$(mail())).data; }
    function activoG() { return logueado() && exists(/databases/$(database)/documents/users/$(mail())) && perfilDe().activo == true; }
    function esSuperadmin() { return logueado() && exists(/databases/$(database)/documents/superadmins/$(mail())); }

    // Una inmobiliaria está vigente si está activa, o en prueba y la semana todavía no terminó.
    function vigente(nid) {
      let n = get(/databases/$(database)/documents/negocios/$(nid)).data;
      return n.estado == 'activo' || (n.estado == 'prueba' && (n.get('vence', null) == null || n.vence > request.time));
    }
    function personalDe(nid) { return activoG() && perfilDe().negocio_id == nid && vigente(nid); }
    function seniorDe(nid) { return personalDe(nid) && perfilDe().rol_jerarquia == 'senior'; }

    // ── Administradores de The DOM Studio Web ─────────────────────
    // Solo existen si se cargan a mano en la consola. Pueden dar de alta inmobiliarias y sus primeros usuarios.
    match /superadmins/{id} {
      allow get: if logueado() && id == mail();
    }

    // ── Inmobiliarias ──────────────────────────────────────────────
    // Los miembros leen la ficha de su inmobiliaria (aunque esté vencida, para poder avisarles). La Dirección fija el vencimiento de
    // la prueba una sola vez, en su primer ingreso, y nunca más de 7 días (1 día de margen por el reloj del teléfono).
    match /negocios/{nid} {
      allow get: if esSuperadmin() || (activoG() && perfilDe().negocio_id == nid);
      allow list, create, delete: if esSuperadmin();
      allow update: if esSuperadmin()
        || (activoG() && perfilDe().negocio_id == nid && perfilDe().rol_jerarquia == 'senior'
            && resource.data.estado == 'prueba' && resource.data.get('vence', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vence'])
            && request.resource.data.vence <= request.time + duration.value(8, 'd'));

      // Datos de la inmobiliaria (nombre, teléfono de WhatsApp para avisos). Lo lee el equipo; solo la Dirección lo cambia.
      match /config/{id} {
        allow read: if personalDe(nid);
        allow write: if seniorDe(nid);
      }

      // (Las lecturas comparan los campos directamente: así Firestore puede validar las consultas «mis propiedades».)
      // Niveles: senior = Dirección (ve y gestiona todo), semisenior = Corredor, asistente = Gestor.
      // Corredor y Gestor ven solo lo que captaron o se les asignó; la Dirección ve y reasigna todo.
      // El Gestor no puede dar por cerrada una operación (eso lo hace un Corredor o la Dirección).
      // Propiedades captadas. La foto va reducida dentro del documento (tope de tamaño).
      match /props/{id} {
        allow read: if seniorDe(nid) || (personalDe(nid) && (resource.data.creado_por == mail() || resource.data.asignado == mail()));
        allow create: if personalDe(nid)
          && request.resource.data.get('img', '').size() < 450000
          && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() < 200
          && request.resource.data.get('creado_por', '') == mail()
          && (seniorDe(nid) || request.resource.data.get('asignado', '') == mail());
        allow update: if (seniorDe(nid) || (personalDe(nid)
              && (resource.data.get('creado_por', '') == mail() || resource.data.get('asignado', '') == mail())
              && request.resource.data.get('creado_por', '') == resource.data.get('creado_por', '')
              && request.resource.data.get('asignado', '') == resource.data.get('asignado', '')
              && !(perfilDe().rol_jerarquia == 'asistente' && request.resource.data.get('estado', '').matches('Cerrada.*'))))
          && request.resource.data.get('img', '').size() < 450000;
        allow delete: if seniorDe(nid);

        // Fotos adicionales de la propiedad: una foto reducida por documento (sin Storage). Las ve y las maneja quien ve la propiedad.
        match /fotos/{fid} {
          function propDe() { return get(/databases/$(database)/documents/negocios/$(nid)/props/$(id)).data; }
          function conAcceso() { return seniorDe(nid) || (personalDe(nid) && (propDe().get('creado_por', '') == mail() || propDe().get('asignado', '') == mail())); }
          allow read: if conAcceso();
          allow create: if conAcceso() && request.resource.data.img is string && request.resource.data.img.size() < 450000 && request.resource.data.get('creado_por', '') == mail();
          allow delete: if conAcceso();
        }
      }

      // Fichas de propietarios e inquilinos (datos y notas; sin documentos adjuntos). Mismo criterio de visibilidad; solo la Dirección elimina.
      match /personas/{id} {
        allow read: if seniorDe(nid) || (personalDe(nid) && (resource.data.creado_por == mail() || resource.data.asignado == mail()));
        allow create: if personalDe(nid) && request.resource.data.get('creado_por', '') == mail()
          && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() < 200
          && request.resource.data.tipo in ['propietario', 'inquilino']
          && (seniorDe(nid) || request.resource.data.get('asignado', '') == mail());
        allow update: if seniorDe(nid) || (personalDe(nid)
              && (resource.data.get('creado_por', '') == mail() || resource.data.get('asignado', '') == mail())
              && request.resource.data.get('creado_por', '') == resource.data.get('creado_por', '')
              && request.resource.data.get('asignado', '') == resource.data.get('asignado', ''));
        allow delete: if seniorDe(nid);
      }

      // Consultas de personas interesadas: mismo criterio de visibilidad.
      match /leads/{id} {
        allow read: if seniorDe(nid) || (personalDe(nid) && (resource.data.creado_por == mail() || resource.data.asignado == mail()));
        allow create: if personalDe(nid) && request.resource.data.get('creado_por', '') == mail()
          && (seniorDe(nid) || request.resource.data.get('asignado', '') == mail());
        allow update, delete: if seniorDe(nid) || (personalDe(nid) && (resource.data.get('creado_por', '') == mail() || resource.data.get('asignado', '') == mail()));
      }
    }

    // ── Equipo ─────────────────────────────────────────────────────
    // Cada persona lee su propio perfil. El equipo ve solo a los de su misma inmobiliaria.
    // La Dirección da de alta, cambia el nivel o da de baja, siempre dentro de su inmobiliaria.
    match /users/{id} {
      allow get: if esSuperadmin() || (logueado() && id == mail()) || (activoG() && perfilDe().negocio_id == resource.data.negocio_id);
      allow list: if esSuperadmin() || (activoG() && vigente(perfilDe().negocio_id) && resource.data.negocio_id == perfilDe().negocio_id);
      allow create: if esSuperadmin()
        || (activoG() && vigente(perfilDe().negocio_id) && perfilDe().rol_jerarquia == 'senior' && request.resource.data.negocio_id == perfilDe().negocio_id);
      allow update: if esSuperadmin()
        || (activoG() && vigente(perfilDe().negocio_id) && perfilDe().rol_jerarquia == 'senior'
            && resource.data.negocio_id == perfilDe().negocio_id && request.resource.data.negocio_id == perfilDe().negocio_id);
      allow delete: if esSuperadmin()
        || (activoG() && vigente(perfilDe().negocio_id) && perfilDe().rol_jerarquia == 'senior' && resource.data.negocio_id == perfilDe().negocio_id);
    }
  }
}
